
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUserDoc().data.selectedRole;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentRole() == 'admin';
    }

    function isSeller() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (currentRole() == 'seller' || currentRole() == 'franchise');
    }

    function isInstitutionalBuyer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentRole() == 'institutional_buyer';
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentRole() == 'staff';
    }

    function isOperator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentRole() == 'operator';
    }

    function isTrustedAnalyticsRole() {
      return isAdmin() || isStaff() || isOperator();
    }

    function canReadUserScopedAggregate() {
      return isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    function isOperationalRole() {
      return isAdmin() || isSeller() || isInstitutionalBuyer();
    }

    // ============================================
    // USERS COLLECTION - User profiles
    // ============================================
    match /users/{userId} {
      // Own profile or admin full access.
      // Read-only seller identity access supports trust strip verification checks.
      allow read: if isOwner(userId) ||
        isAdmin() ||
        (isAuthenticated() && (
          resource.data.selectedRole == 'seller' ||
          resource.data.selectedRole == 'franchise'
        ));

      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      // Notification preferences under users/{uid}/preferences/notifications
      match /preferences/{prefId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if false;
      }
    }

    // ============================================
    // MEMBERS COLLECTION - Member profile/benefit data
    // ============================================
    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdmin();
      allow create, update: if isOwner(memberId) || isAdmin();
      allow delete: if false;
    }

    // ============================================
    // CART ITEMS COLLECTION - User shopping cart
    // ============================================
    match /cartItems/{cartItemId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ============================================
    // FAVORITES COLLECTION - User favorites
    // ============================================
    match /favorites/{favoriteId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ============================================
    // NOTIFICATIONS - User scoped notifications
    // ============================================
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isAdmin() ||
        (
          request.resource.data.type == 'message' &&
          (
            request.resource.data.data.buyerId == request.auth.uid ||
            request.resource.data.data.sellerId == request.auth.uid
          )
        )
      );
    }

    // ============================================
    // INQUIRIES - Buyer to seller quote/chat workflow
    // ============================================
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || isAdmin()
      );

      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ============================================
    // ORDERS - Buyer/user scoped orders
    // ============================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin() ||
        isSeller()
      );

      allow delete: if false;
    }

    // ============================================
    // PRODUCTS - Marketplace inventory
    // ============================================
    match /products/{productId} {
      // Product catalog is visible to signed-in marketplace users.
      allow read: if isAuthenticated();

      // Sellers/admin manage inventory records.
      allow create: if isAuthenticated() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // ACTIVITY LOGS - User history and analytics events
    // ============================================
    match /activityLogs/{activityId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTrustedAnalyticsRole()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ============================================
    // OPERATIONAL INTELLIGENCE AGGREGATES
    // ============================================
    match /analyticsDaily/{docId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    match /anomalyAlerts/{alertId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    match /intelligenceRuns/{runId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // GLOBAL SETTINGS - shared UI settings document
    // ============================================
    match /global_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
