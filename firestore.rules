
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
            // ============================================
            // CART ITEMS COLLECTION - User shopping cart
            // Each document: id = {userId}_{productId}, field userId
            match /cartItems/{cartItemId} {
              // Read: Only owner
              allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;

              // Create: Only owner can add to their own cart
              allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;

              // Update: Only owner can update their cart
              allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;

              // Delete: Only owner can delete their cart item
              allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
            }
        // ============================================
        // FAVORITES COLLECTION - User favorites
        // Each document: id = {userId}_{productId}, field userId
        match /favorites/{favoriteId} {
          // Read: Only owner
          allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;

          // Create: Only owner can create their own favorite
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;

          // Update: Only owner can update their favorite
          allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;

          // Delete: Only owner can delete their favorite
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // Safely get user role, returns null if document doesn't exist
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.selectedRole;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRole == 'admin';
    }
    
    function isSeller() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRole == 'seller' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRole == 'franchise');
    }
    
    function isMember() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRole == 'member' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.selectedRole == 'buyer');
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isDocOwner(uid) {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // USERS COLLECTION - User profiles
    // ============================================
    match /users/{userId} {
      // Read own profile
      allow read: if isOwner(userId);
      
      // Create: Only during registration (new user creating their own profile)
      allow create: if isOwner(userId);
      
      // Update: Only own profile
      allow update: if isOwner(userId);
      
      // Delete: Never
      allow delete: if false;
    }
    
    // ============================================
    // MEMBERS COLLECTION - Member financial data
    // ============================================
    match /members/{memberId} {
      // Read: Own member data or admin
      allow read: if isOwner(memberId) || isAdmin();
      
      // Create: Only own member record during signup

      allow create: if isOwner(memberId);
    }
  }
}
