
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function currentUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUserDocExists() ? currentUserDoc().data.selectedRole : 'member';
    }

    function isAdmin() {
      return isAuthenticated() &&
        currentUserDocExists() &&
        currentRole() in ['admin', 'super_admin'];
    }

    function isSeller() {
      return isAuthenticated() &&
        currentUserDocExists() &&
        (currentRole() == 'seller' ||
          (currentUserDoc().data.roles is list &&
            currentUserDoc().data.roles.hasAny(['seller'])));
    }

    function isStaff() {
      return isAuthenticated() &&
        currentUserDocExists() &&
        currentRole() == 'staff';
    }

    function isOperator() {
      return isAuthenticated() &&
        currentUserDocExists() &&
        currentRole() == 'operator';
    }

    function isTrustedAnalyticsRole() {
      return isAdmin() || isStaff() || isOperator();
    }

    function canReadUserScopedAggregate() {
      return isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    function isPublicRole(role) {
      return role in ['member', 'seller', 'institutional_buyer'];
    }

    function hasValidPublicRoles(data) {
      return data.roles is list &&
        data.roles.size() > 0 &&
        data.roles.hasOnly(['member', 'seller', 'institutional_buyer']) &&
        isPublicRole(data.selectedRole) &&
        data.roles.hasAny([data.selectedRole]);
    }

    function hasPendingRoleProfile(data) {
      return data.roles is list &&
        data.roles.size() == 0 &&
        data.selectedRole == 'pending_role' &&
        data.membershipType == 'pending_role' &&
        data.roleSelectionComplete == false;
    }

    function hasValidRoleMembershipStatus(data) {
      return (data.selectedRole == 'member' && data.membershipStatus == 'pending') ||
        (data.selectedRole != 'member' && data.membershipStatus == 'inactive');
    }

    function isInitialRoleAssignment() {
      return resource.data.roles is list &&
        resource.data.roles.size() == 0 &&
        resource.data.selectedRole == 'pending_role' &&
        resource.data.roleSelectionComplete == false &&
        hasValidPublicRoles(request.resource.data) &&
        request.resource.data.roleSelectionComplete == true &&
        request.resource.data.membershipType == request.resource.data.selectedRole &&
        hasValidRoleMembershipStatus(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'roles',
          'selectedRole',
          'membershipType',
          'roleSelectionComplete',
          'membershipStatus',
          'updatedAt'
        ]);
    }

    function isPendingProfileMaintenance() {
      return hasPendingRoleProfile(resource.data) &&
        hasPendingRoleProfile(request.resource.data) &&
        request.resource.data.roles == resource.data.roles &&
        request.resource.data.selectedRole == resource.data.selectedRole &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'profilePicture',
          'phone',
          'address',
          'onboardingCompleted',
          'updatedAt'
        ]);
    }

    function hasOnlyPublicUserProfileFields(data) {
      return data.keys().hasOnly([
        'id',
        'email',
        'name',
        'roles',
        'selectedRole',
        'membershipType',
        'roleSelectionComplete',
        'onboardingCompleted',
        'membershipStatus',
        'memberTier',
        'createdAt',
        'updatedAt',
        'profilePicture',
        'phone',
        'address',
        'isActive'
      ]);
    }

    function isSellerForOrder(data) {
      return isAuthenticated() && (
        data.sellerId == request.auth.uid ||
        (
          data.keys().hasAny(['sellerIds']) &&
          data.sellerIds is list &&
          data.sellerIds.hasAny([request.auth.uid])
        )
      );
    }

    // ============================================
    // USERS COLLECTION - User profiles
    // ============================================
    match /users/{userId} {
      // User profiles contain private identity and payout-adjacent data.
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
        hasOnlyPublicUserProfileFields(request.resource.data) &&
        (hasPendingRoleProfile(request.resource.data) ||
          hasValidPublicRoles(request.resource.data)) &&
        (!request.resource.data.keys().hasAny(['membershipStatus']) ||
          request.resource.data.membershipStatus in ['pending', 'inactive']) &&
        (!request.resource.data.keys().hasAny(['memberTier']) ||
          request.resource.data.memberTier == 'bronze');

      allow update: if isAdmin() ||
        (isOwner(userId) && isInitialRoleAssignment()) ||
        (isOwner(userId) && isPendingProfileMaintenance()) ||
        (
          isOwner(userId) &&
          hasValidPublicRoles(request.resource.data) &&
          request.resource.data.roles == resource.data.roles &&
          request.resource.data.selectedRole in resource.data.roles &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'profilePicture',
            'phone',
            'address',
            'onboardingCompleted',
            'roleSelectionComplete',
            'selectedRole',
            'updatedAt'
          ])
        );
      allow delete: if false;

      // Notification preferences under users/{uid}/preferences/notifications
      match /preferences/{prefId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if false;
      }
    }

    // ============================================
    // MEMBERS COLLECTION - Member profile/benefit data
    // ============================================
    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdmin();
      allow create: if isOwner(memberId) &&
        request.resource.data.tier == 'bronze' &&
        request.resource.data.loyaltyPoints == 0 &&
        request.resource.data.totalPurchases == 0 &&
        request.resource.data.isVerified == false &&
        request.resource.data.isActive == false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================
    // CART ITEMS COLLECTION - User shopping cart
    // ============================================
    match /cartItems/{cartItemId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId);
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // ============================================
    // FAVORITES COLLECTION - User favorites
    // ============================================
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId);
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // ============================================
    // NOTIFICATIONS - User scoped notifications
    // ============================================
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isAdmin() ||
        (
          request.resource.data.type == 'message' &&
          (
            request.resource.data.data.buyerId == request.auth.uid ||
            request.resource.data.data.sellerId == request.auth.uid
          )
        )
      );
    }

    // ============================================
    // INQUIRIES - Buyer to seller quote/chat workflow
    // ============================================
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || isAdmin()
      );

      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if false;
    }

    // ============================================
    // ORDERS - Buyer/user scoped orders
    // ============================================
    match /orders/{orderId} {
      // Quote drafts are stored separately below; orders remain server-created.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isSellerForOrder(resource.data) ||
        isAdmin()
      );

      allow create: if false;

      allow update: if isAdmin() || (
        isSellerForOrder(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'trackingNumber', 'deliveryDate', 'updatedAt'
        ]) &&
        request.resource.data.status in ['processing', 'shipped', 'delivered']
      );

      allow delete: if false;
    }

    // ============================================
    // PRODUCTS - Marketplace inventory
    // ============================================
    match /products/{productId} {
      // Marketplace users see live inventory; sellers retain access to their
      // own drafts and admins retain moderation access.
      allow read: if isAuthenticated() && (
        resource.data.status == 'live' ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      // Server creation is preferred. This tightly constrained path keeps
      // seller drafts/review submissions available if platform credentials
      // are temporarily unavailable; clients can never self-publish live.
      allow create: if isSeller() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending'] &&
        request.resource.data.isActive == false &&
        request.resource.data.isFeatured == false &&
        request.resource.data.sellerVerified == false &&
        request.resource.data.requiresReview == (request.resource.data.status == 'pending') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000 &&
        (request.resource.data.status == 'draft' || request.resource.data.description.size() >= 10) &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 100 &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.price <= 1000000000 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= 10000000 &&
        request.resource.data.type in ['retail', 'wholesale', 'both'] &&
        request.resource.data.minOrderQuantity is number &&
        request.resource.data.minOrderQuantity >= 1 &&
        request.resource.data.minOrderQuantity <= 1000000 &&
        (request.resource.data.type == 'retail' || (
          request.resource.data.wholesalePrice is number &&
          request.resource.data.wholesalePrice > 0 &&
          request.resource.data.wholesalePrice <= 1000000000
        )) &&
        request.resource.data.images is list &&
        request.resource.data.images.size() <= 10 &&
        request.resource.data.thumbnail is string &&
        request.resource.data.thumbnail.size() <= 2000 &&
        request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'type', 'price', 'retailPrice',
          'wholesalePrice', 'originalPrice', 'discount', 'minOrderQuantity',
          'stock', 'unit', 'maxOrder', 'status', 'images', 'thumbnail',
          'sellerId', 'sellerName', 'sellerVerified', 'ownershipType',
          'rating', 'reviews', 'isFeatured', 'isActive', 'requiresReview',
          'createdAt', 'updatedAt', 'publishedAt'
        ]);

      allow update: if isAdmin() || (
        isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'category', 'type', 'price', 'retailPrice',
          'wholesalePrice', 'originalPrice', 'discount', 'minOrderQuantity',
          'stock', 'unit', 'maxOrder', 'status', 'isActive', 'images',
          'thumbnail', 'requiresReview', 'publishedAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['draft', 'pending', 'live'] &&
        (request.resource.data.status != 'live' || resource.data.status == 'live') &&
        request.resource.data.isActive == (request.resource.data.status == 'live') &&
        request.resource.data.isFeatured == false &&
        request.resource.data.requiresReview == (request.resource.data.status == 'pending') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000 &&
        (request.resource.data.status != 'live' || request.resource.data.description.size() >= 10) &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.price <= 1000000000 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= 10000000 &&
        request.resource.data.type in ['retail', 'wholesale', 'both'] &&
        request.resource.data.minOrderQuantity is number &&
        request.resource.data.minOrderQuantity >= 1 &&
        request.resource.data.minOrderQuantity <= 1000000
      );
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /quoteDrafts/{draftId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /governanceMotions/{motionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /memberVotes/{voteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        currentRole() == 'member' &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.motionId is string &&
        request.resource.data.optionId is string;
      allow update: if isAuthenticated() &&
        currentRole() == 'member' &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.motionId == resource.data.motionId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionId', 'updatedAt']);
      allow delete: if false;
    }

    // ============================================
    // TRANSACTIONS - Server-created payment intents and receipts
    // ============================================
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'proof_uploaded' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'proofUrl', 'proofFileName', 'status', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // ============================================
    // CONVERSATIONS AND MESSAGES
    // ============================================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
        resource.data.participants is list &&
        resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() &&
        resource.data.participants.hasAny([request.auth.uid]) &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'unreadCount', 'isArchived'
        ]);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000;
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['delivered', 'read'];
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // ============================================
    // OFFERS AND REVIEWS
    // ============================================
    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ============================================
    // ACTIVITY LOGS - User history and analytics events
    // ============================================
    match /activityLogs/{activityId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTrustedAnalyticsRole()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ============================================
    // OPERATIONAL INTELLIGENCE AGGREGATES
    // ============================================
    match /analyticsDaily/{docId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    match /anomalyAlerts/{alertId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    match /intelligenceRuns/{runId} {
      allow read: if isTrustedAnalyticsRole() || canReadUserScopedAggregate();
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // GLOBAL SETTINGS - shared UI settings document
    // ============================================
    match /global_settings/{docId} {
      allow read: if true;
      // Commerce prices and commissions are written only by server routes
      // after Firebase token/claim verification. Firebase Admin bypasses rules.
      allow create, update, delete: if isAdmin() && docId != 'commerce';
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
